---
import BaseLayout from "../layouts/BaseLayout.astro";
import { paths } from "../data/navigation";
---

<BaseLayout title="Page not found · zxxdev" description="This page doesn't exist.">
  <section class="max-w-[42rem] pt-10 sm:pt-18">
    <p class="font-mono text-sm text-muted">404</p>
    <h1 class="mt-2 text-h2 font-medium tracking-[-0.02em]">This page doesn't exist.</h1>
    <p class="mt-4 text-muted">The link may be out of date.</p>
    <p class="mt-8">
      <a href={paths.home}>Back to home</a>
    </p>
  </section>
</BaseLayout>
