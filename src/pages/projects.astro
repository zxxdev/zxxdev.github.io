---
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { featuredProjects } from "../data/profile";
---

<BaseLayout title="Projects · zxxdev" description="What I'm building, with its actual status.">
  <section class="pt-10 sm:pt-18">
    <h1 class="text-h2 font-medium tracking-[-0.02em]">Projects</h1>
    <p class="mt-3.5 max-w-[42rem] text-muted">What I'm building, with its actual status.</p>
    <ul class="mt-8 grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => <ProjectCard project={project} />)}
    </ul>
  </section>
</BaseLayout>
