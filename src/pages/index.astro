---
import BaseLayout from "../layouts/BaseLayout.astro";
import { profileUrl } from "../data/navigation";
---

<BaseLayout
  title="zxxdev"
  description="Systems engineer building backend services and the platforms they run on."
>
  <section class="max-w-[42rem] py-16 sm:py-24">
    <p class="font-mono text-sm text-violet">zxxdev</p>
    <h1 class="mt-3 text-h2 font-semibold tracking-tight text-balance sm:text-h1">
      Systems engineer building backend services and the platforms they run on.
    </h1>
    <p class="mt-6 text-muted">
      This site is under construction. Projects, notes and the full story are on their way.
    </p>
    <p class="mt-8">
      <a href={profileUrl}>See what I'm building on GitHub</a>
    </p>
  </section>
</BaseLayout>
