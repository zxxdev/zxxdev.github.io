---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout
  title="zxxdev"
  description="Systems engineer building backend services and the platforms they run on."
>
  <main class="mx-auto flex min-h-dvh max-w-2xl flex-col justify-center gap-6 px-6 py-16">
    <p class="font-mono text-sm text-neutral-500 dark:text-neutral-400">zxxdev</p>
    <h1 class="text-4xl font-semibold tracking-tight sm:text-5xl">
      Systems engineer building backend services and the platforms they run on.
    </h1>
    <p class="text-lg text-neutral-600 dark:text-neutral-300">
      This site is under construction. Projects, notes and the full story are on their way.
    </p>
    <p>
      <a
        class="font-medium underline decoration-neutral-400 underline-offset-4 hover:decoration-current"
        href="https://github.com/zxxdev"
      >
        See what I'm building on GitHub
      </a>
    </p>
  </main>
</BaseLayout>
