---
/*
 * One page per project, made from its Markdown file: the front matter gives
 * the header, the cover and the facts on the side; the body is the text.
 *
 * getStaticPaths runs while building and returns one page per file, so adding
 * a project file adds its page. There is no server deciding this later.
 */
import type { GetStaticPaths } from "astro";
import { getCollection, render, type CollectionEntry } from "astro:content";
import ProjectVisual from "../../components/ProjectVisual.astro";
import StatusTag from "../../components/StatusTag.astro";
import TechPill from "../../components/TechPill.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { paths } from "../../data/navigation";

export const getStaticPaths = (async () => {
  const projects = await getCollection("projects");
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}) satisfies GetStaticPaths;

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { id, data } = project;
const { Content } = await render(project);
const repositoryUrl = `https://github.com/${data.repo}`;
---

<BaseLayout title={`${data.title} · Projects · zxxdev`} description={data.summary}>
  <article data-tone={data.tone} class="pt-8 sm:pt-12">
    <a
      href={paths.projects}
      class="inline-flex h-8 items-center gap-1 text-sm text-muted no-underline visited:text-muted hover:text-text"
    >
      <span aria-hidden="true">←</span> All projects
    </a>

    <div class="mt-6 grid gap-8 md:grid-cols-2 md:items-center md:gap-10">
      <header>
        <StatusTag status={data.status} />
        <h1 class="mt-4 text-h2 font-medium tracking-[-0.02em]">{data.title}</h1>
        <p class="mt-1 font-mono text-sm text-muted">{data.repo}</p>
        <p class="mt-4 text-lead">{data.summary}</p>
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a
            href={repositoryUrl}
            class="inline-flex h-10 items-center rounded-full bg-brand px-4.5 text-sm font-medium text-on-brand no-underline transition-colors visited:text-on-brand hover:bg-brand-hover"
          >
            View on GitHub
          </a>
          {data.demo && (
            <a
              href={data.demo}
              class="inline-flex h-10 items-center rounded-full border border-border bg-surface-2 px-4.5 text-sm font-medium text-text no-underline transition-colors visited:text-text hover:border-border-strong"
            >
              Live demo
            </a>
          )}
        </div>
      </header>

      <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-border bg-tone-bg">
        <ProjectVisual
          {id}
          project={data}
          sizes="(min-width: 1024px) 476px, (min-width: 768px) 46vw, 95vw"
          loading="eager"
          tagSpace={false}
        />
      </div>
    </div>

    <div class="mt-12 grid gap-10 border-t border-border pt-10 sm:mt-16 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <!-- 36rem keeps lines under about 78 characters. -->
      <div class="project-text max-w-[36rem]">
        <Content />
      </div>

      <!-- On wide screens the facts stay in view while the text scrolls (header 60 px + 36 px). -->
      <aside aria-label="Project facts" class="lg:sticky lg:top-24 lg:self-start">
        <dl class="grid gap-6">
          <div>
            <dt class="text-sm font-medium">Stack</dt>
            <dd class="mt-2.5">
              <ul class="flex flex-wrap gap-1.5">
                {data.stack.map((item) => (
                  <li>
                    <TechPill name={item} />
                  </li>
                ))}
              </ul>
            </dd>
          </div>
          {data.tooling.length > 0 && (
            <div>
              <dt class="text-sm font-medium">Tooling</dt>
              <dd class="mt-2.5">
                <ul class="flex flex-wrap gap-1.5">
                  {data.tooling.map((item) => (
                    <li>
                      <TechPill name={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          <div>
            <dt class="text-sm font-medium">Source</dt>
            <dd class="mt-1.5 font-mono text-sm">
              <a href={repositoryUrl}>{data.repo}</a>
            </dd>
          </div>
        </dl>
      </aside>
    </div>
  </article>
</BaseLayout>
