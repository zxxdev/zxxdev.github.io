---
import Icon from "../components/Icon.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profileUrl } from "../data/navigation";
import { azureExams, path } from "../data/profile";

/** The page's sections, in order. The links work without JavaScript. */
const sections = [
  { id: "intro", label: "Intro" },
  { id: "path", label: "Path" },
  { id: "exams", label: "Azure exams" },
] as const;
---

<BaseLayout
  title="About · zxxdev"
  description="From running systems and supporting users to building backend services and platforms."
>
  <article class="max-w-[48rem] pt-10 sm:pt-18">
    <h1 class="text-h2 font-medium tracking-[-0.02em]">About</h1>

    <!--
      Section links. Sticky under the site header (56 px, 60 px from sm). Without
      JavaScript they are plain anchor links; the script below only marks the
      section being read with aria-current.
    -->
    <nav
      aria-label="On this page"
      class="sticky top-14 z-10 -mx-4 mt-5 border-b border-border bg-bg px-4 py-2.5 sm:top-15 sm:-mx-0 sm:px-0"
      data-section-nav
    >
      <ul class="flex flex-wrap gap-1 text-sm font-medium">
        {
          sections.map((section) => (
            <li>
              <a
                href={`#${section.id}`}
                class="block rounded-md px-3 py-1.5 text-muted no-underline visited:text-muted hover:text-text aria-[current=true]:bg-surface-2 aria-[current=true]:text-text"
              >
                {section.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div id="intro" class="mt-8 max-w-[42rem] scroll-mt-32 space-y-5 text-lead">
      <p>
        I'm a computer engineer. I've spent years on the operations side: running systems,
        supporting users and building websites.
      </p>
      <p>
        That work teaches things tutorials don't: what actually breaks, what people need when
        something stops working, and what it costs to maintain what someone else left half-finished.
        Now I build software for those same problems: support workflows, deployments, observability
        and automation.
      </p>
      <p>
        The systems background shows in how I work. Before I call something done, I ask what happens
        when it fails, who will maintain it and how anyone can tell it works. That's why every
        project has tests, every important decision is written down, and every figure on this site
        is computed by CI.
      </p>
      <p>
        The code in these projects is written by AI agents under my direction. I decide what gets
        built, review every change and answer for every decision. Nothing reaches the main branch
        without passing tests and CI.
      </p>
      <p>
        I've passed Microsoft's Azure exams in administration (AZ-104), networking (AZ-700) and
        architecture design (AZ-304). At home I run a small virtualization server where I test these
        projects.
      </p>
    </div>

    <section
      id="path"
      aria-labelledby="path-title"
      class="mt-14 max-w-[42rem] scroll-mt-32"
      data-tone="violet"
    >
      <h2 id="path-title" class="border-b border-border pb-3.5 text-h3 font-medium tracking-[-0.01em]">
        The path so far
      </h2>
      <ol class="mt-6">
        {
          path.map((stage, index) => (
            <li class="relative border-l border-border pb-7 pl-6 last:pb-0">
              <span
                aria-hidden="true"
                class="absolute top-1 -left-1 size-[9px] rounded-full bg-tone-line"
              />
              <p class="font-mono text-xs text-muted">{String(index + 1).padStart(2, "0")}</p>
              <h3 class="font-semibold">{stage.title}</h3>
              <p class="mt-1 text-sm text-muted">{stage.summary}</p>
            </li>
          ))
        }
      </ol>
    </section>

    <section id="exams" aria-labelledby="exams-title" class="mt-14 scroll-mt-32">
      <h2 id="exams-title" class="border-b border-border pb-3.5 text-h3 font-medium tracking-[-0.01em]">
        Azure exams
      </h2>
      <p class="mt-3.5 text-sm text-muted">
        Microsoft exams I've passed. The certifications they led to have since expired.
      </p>
      <ul class="mt-6 grid gap-3 sm:grid-cols-3">
        {
          azureExams.map((exam) => (
            <li class="flex items-start gap-3 rounded-xl border border-border p-4">
              <span class="grid size-8 shrink-0 place-items-center rounded-md bg-surface-2 text-violet">
                <Icon name="badge" />
              </span>
              <div>
                <h3 class="text-sm font-semibold">{exam.area}</h3>
                <p class="mt-1 font-mono text-xs text-muted">
                  {exam.code}
                  {exam.retired ? " · retired exam" : ""}
                </p>
                <p class="mt-1 text-xs leading-relaxed text-muted">{exam.name}</p>
              </div>
            </li>
          ))
        }
      </ul>
    </section>

    <p class="mt-14">
      The way to reach me is <a href={profileUrl}>GitHub</a>.
    </p>
  </article>
</BaseLayout>

<script>
  // Marks the section being read in the "On this page" links. Progressive:
  // without this script the links still work, they just are not highlighted.
  const links = [
    ...document.querySelectorAll<HTMLAnchorElement>("[data-section-nav] a[href^='#']"),
  ];
  const targets = links
    .map((link) => document.getElementById(link.hash.slice(1)))
    .filter((target): target is HTMLElement => target !== null);

  const mark = (id: string): void => {
    for (const link of links) {
      if (link.hash === `#${id}`) link.setAttribute("aria-current", "true");
      else link.removeAttribute("aria-current");
    }
  };

  if (targets.length > 0 && "IntersectionObserver" in window) {
    const first = targets[0];
    if (first) mark(first.id);
    // A section counts as "being read" when it crosses a line a third of the way down the screen.
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (entry.isIntersecting) mark(entry.target.id);
        }
      },
      { rootMargin: "-33% 0px -66% 0px" },
    );
    for (const target of targets) observer.observe(target);

    // The last section may be too short to reach that line: at the bottom of the page, mark it.
    const last = targets[targets.length - 1];
    window.addEventListener(
      "scroll",
      () => {
        const atBottom = window.innerHeight + window.scrollY >= document.body.scrollHeight - 2;
        if (atBottom && last) mark(last.id);
      },
      { passive: true },
    );
  }
</script>
