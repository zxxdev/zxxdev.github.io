---
/*
 * Every project, with a filter by technology.
 *
 * The filter is progressive enhancement: the buttons are hidden in the HTML and
 * the script shows them. Without JavaScript the page is the full list, which
 * is still complete. The chosen technology goes in the address (?tech=lua), so
 * a filtered list can be linked; replaceState keeps the Back button for leaving
 * the page, not for undoing filters.
 *
 * Written once for both languages: src/pages/projects/index.astro and
 * src/pages/es/proyectos/index.astro only choose the language. The script's
 * messages come from data attributes, in the page's language.
 */
import ProjectCard from "../components/ProjectCard.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { technologySlug } from "../data/technologies";
import type { Locale } from "../i18n/locales";
import { ui } from "../i18n/ui";
import { filterTechnologies } from "../lib/projects";
import { getProjects } from "../lib/site-projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale].projects;

// The project files and every other public repository, from GitHub.
const projects = await getProjects(locale);
const technologies = filterTechnologies(projects.map((project) => project.data));

/*
 * Filter buttons: neutral pills like the technology pills, 32 px high. The
 * chosen one is filled with the text colour, so it is told apart by more than a
 * colour change, and aria-pressed says it to screen readers. Hover only
 * changes the buttons not chosen: the chosen one keeps its colours (otherwise
 * its text would take the fill colour and disappear).
 */
const filterButton =
  "inline-flex h-8 shrink-0 cursor-pointer items-center rounded-full border border-border bg-bg px-3 font-mono text-xs text-muted transition-colors aria-[pressed=false]:hover:border-border-strong aria-[pressed=false]:hover:text-text aria-pressed:cursor-default aria-pressed:border-text aria-pressed:bg-text aria-pressed:text-bg";
---

<BaseLayout title={t.title} description={t.description} {locale} route={{ page: "projects" }}>
  <section class="pt-10 sm:pt-18">
    <h1 class="text-h2 font-medium tracking-[-0.02em]">{t.heading}</h1>
    <p class="mt-3.5 max-w-[42rem] text-muted">{t.description}</p>

    <div
      data-project-filter
      data-showing-all={t.showingAll}
      data-showing-some={t.showingSome}
      hidden
      class="mt-8"
    >
      <p id="filter-label" class="text-sm font-medium">
        {t.filterLabel}
      </p>
      <!--
        On a phone the buttons stay in one row that scrolls sideways, running to
        the screen edge so the last one is cut and shows there is more. py-1
        keeps the focus ring from being clipped by the scrolling box.
      -->
      <div
        role="group"
        aria-labelledby="filter-label"
        class="mt-3 flex flex-wrap gap-1.5 max-sm:-mx-4 max-sm:mt-2 max-sm:flex-nowrap max-sm:overflow-x-auto max-sm:px-4 max-sm:py-1 max-sm:[scrollbar-width:none]"
      >
        <button type="button" data-technology="" aria-pressed="true" class={filterButton}>
          {t.filterAll}
        </button>
        {technologies.map((name) => (
          <button
            type="button"
            data-technology={technologySlug(name)}
            aria-pressed="false"
            class={filterButton}
          >
            {name}
          </button>
        ))}
      </div>
      <p data-filter-status aria-live="polite" class="mt-3 text-sm text-muted"></p>
    </div>

    <!-- Only for screen readers: keeps the headings in order (h1, h2, then the cards' h3). -->
    <h2 class="sr-only">{t.listHeading}</h2>
    <ul data-project-list class="mt-6 grid gap-4 sm:grid-cols-2">
      {projects.map((project) => (
        <ProjectCard {project} {locale} />
      ))}
    </ul>
  </section>
</BaseLayout>

<script>
  const filter = document.querySelector<HTMLElement>("[data-project-filter]");
  const list = document.querySelector<HTMLElement>("[data-project-list]");

  if (filter && list) {
    const buttons = [...filter.querySelectorAll<HTMLButtonElement>("button[data-technology]")];
    const cards = [...list.querySelectorAll<HTMLElement>(":scope > [data-technologies]")];
    const status = filter.querySelector<HTMLElement>("[data-filter-status]");
    const known = new Set(buttons.map((button) => button.dataset["technology"] ?? ""));

    /**
     * Shows the cards that use `technology` ("" shows all). `fromClick` is false
     * on page load: then the address is left as it is, and the count is only
     * written for a filtered list, so a screen reader does not announce
     * anything before the visitor does something.
     */
    const apply = (technology: string, fromClick: boolean): void => {
      // An unknown ?tech= value (an old link, a typo) shows everything.
      const chosen = known.has(technology) ? technology : "";

      for (const button of buttons) {
        button.setAttribute("aria-pressed", String(button.dataset["technology"] === chosen));
      }

      let shown = 0;
      for (const card of cards) {
        const uses = (card.dataset["technologies"] ?? "").split(" ");
        card.hidden = chosen !== "" && !uses.includes(chosen);
        if (!card.hidden) shown += 1;
      }

      if (status && (fromClick || chosen !== "")) {
        // The sentences come from the page, in its language: {total} and {shown} are filled in here.
        const template =
          (chosen === "" ? filter.dataset["showingAll"] : filter.dataset["showingSome"]) ?? "";
        status.textContent = template
          .replace("{total}", String(cards.length))
          .replace("{shown}", String(shown));
      }

      if (fromClick) {
        const url = new URL(window.location.href);
        if (chosen === "") url.searchParams.delete("tech");
        else url.searchParams.set("tech", chosen);
        window.history.replaceState(null, "", url);
      }
    };

    for (const button of buttons) {
      button.addEventListener("click", () => {
        apply(button.dataset["technology"] ?? "", true);
      });
    }

    filter.hidden = false;
    apply(new URLSearchParams(window.location.search).get("tech") ?? "", false);
  }
</script>
