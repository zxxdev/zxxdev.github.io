---
/*
 * The home page, in either language. src/pages/index.astro and
 * src/pages/es/index.astro only choose the language: the page is written once.
 */
import Avatar from "../components/Avatar.astro";
import Icon from "../components/Icon.astro";
import ProjectCard from "../components/ProjectCard.astro";
import SectionHeading from "../components/SectionHeading.astro";
import TechPill from "../components/TechPill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { profileUrl } from "../data/navigation";
import { profile } from "../data/profile";
import type { Locale } from "../i18n/locales";
import { pagePaths } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { technologiesInUse } from "../lib/projects";
import { getProjects } from "../lib/site-projects";

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const t = ui[locale];
const paths = pagePaths[locale];

/** Cards on the home page: the featured projects, then the latest others up to this many. */
const HOME_CARDS = 4;

const projects = await getProjects(locale);
const featured = projects.filter((project) => project.data.featured);
// Projects from GitHub come last in the list, newest push first, so a new
// repository reaches the home page without anyone choosing it.
const featuredProjects = [
  ...featured,
  ...projects.filter((project) => !project.data.featured),
].slice(0, Math.max(featured.length, HOME_CARDS));
// Built from the projects: a technology no project uses is not listed.
const technologies = technologiesInUse(projects.map((project) => project.data));

// Counted from the data, never typed by hand.
const statusLabel = t.home.building(projects.length);
---

<BaseLayout title={t.home.title} description={t.home.description} {locale} route={{ page: "home" }}>
  <section class="pt-10 sm:pt-18">
    <div class="flex flex-wrap items-center gap-3">
      <Avatar size={48} />
      <span class="font-mono text-sm font-medium text-violet">@zxxdev</span>
      <span class="inline-flex h-6 items-center gap-2 rounded-full border border-border bg-surface px-2.5 font-mono text-xs text-text">
        <span aria-hidden="true" class="size-1.5 rounded-full bg-status"></span>
        {statusLabel}
      </span>
    </div>
    <h1 class="mt-6 max-w-[44rem] text-h1 font-medium tracking-[-0.02em] text-balance">
      {t.home.headline}
    </h1>
    <p class="mt-4.5 max-w-[42rem] text-lead">{t.home.lead}</p>
    <div class="mt-7 flex flex-wrap gap-2.5">
      <a
        href={paths.projects}
        class="inline-flex h-10 items-center rounded-full bg-brand px-4.5 text-sm font-medium text-on-brand no-underline transition-colors visited:text-on-brand hover:bg-brand-hover"
      >
        {t.home.viewProjects}
      </a>
      <a
        href={paths.about}
        class="inline-flex h-10 items-center rounded-full border border-border bg-surface-2 px-4.5 text-sm font-medium text-text no-underline transition-colors visited:text-text hover:border-border-strong"
      >
        {t.home.about}
      </a>
      <a
        href={profileUrl}
        class="inline-flex h-10 items-center gap-2 rounded-full border border-border px-4.5 text-sm font-medium text-text no-underline transition-colors visited:text-text hover:border-border-strong"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="16"
          height="16"
          fill="currentColor"
          aria-hidden="true"
        >
          <path d="M12 .5a11.5 11.5 0 0 0-3.64 22.41c.58.1.79-.25.79-.56v-2c-3.2.7-3.88-1.37-3.88-1.37-.53-1.33-1.28-1.69-1.28-1.69-1.05-.71.08-.7.08-.7 1.16.08 1.77 1.19 1.77 1.19 1.03 1.77 2.7 1.26 3.36.96.1-.75.4-1.26.73-1.55-2.55-.29-5.24-1.28-5.24-5.69 0-1.26.45-2.29 1.19-3.1-.12-.29-.52-1.46.11-3.05 0 0 .97-.31 3.17 1.18a11 11 0 0 1 5.77 0c2.2-1.49 3.17-1.18 3.17-1.18.63 1.59.23 2.76.11 3.05.74.81 1.19 1.84 1.19 3.1 0 4.42-2.7 5.39-5.26 5.68.41.36.78 1.06.78 2.14v3.17c0 .31.21.67.8.56A11.5 11.5 0 0 0 12 .5Z"></path>
        </svg>
        GitHub
      </a>
    </div>
  </section>

  <section aria-labelledby="projects-title" class="pt-16 sm:pt-24">
    <SectionHeading
      id="projects-title"
      title={t.home.projects}
      link={{ href: paths.projects, label: t.home.seeAllProjects }}
    />
    <ul class="mt-6 grid gap-4 sm:grid-cols-2">
      {featuredProjects.map((project) => (
        <ProjectCard {project} {locale} />
      ))}
    </ul>
  </section>

  <section aria-labelledby="work-title" class="pt-16 sm:pt-24">
    <SectionHeading id="work-title" title={t.home.howIWork} />
    <ul class="mt-6 grid gap-4 md:grid-cols-3">
      {profile[locale].principles.map((principle) => (
        <li data-tone={principle.tone} class="rounded-xl border border-border p-5">
          <span class="grid size-8 place-items-center rounded-md bg-tone-bg text-tone-line">
            <Icon name={principle.icon} />
          </span>
          <h3 class="mt-3.5 font-semibold">{principle.title}</h3>
          <p class="mt-1.5 text-sm leading-relaxed text-muted">{principle.text}</p>
        </li>
      ))}
    </ul>
  </section>

  <section aria-labelledby="tech-title" class="pt-16 sm:pt-24">
    <SectionHeading id="tech-title" title={t.home.technologies} />
    <p class="mt-3.5 text-sm text-muted">{t.home.technologiesNote}</p>
    <dl class="mt-6 grid gap-4 sm:grid-cols-2">
      {technologies.map((group) => (
        <div class="rounded-xl border border-border px-5 pt-4.5 pb-5">
          <dt class="text-sm font-medium">{t.technologyGroups[group.id]}</dt>
          <dd class="mt-3">
            <ul class="flex flex-wrap gap-1.5">
              {group.items.map((item) => (
                <li>
                  <TechPill name={item} />
                </li>
              ))}
            </ul>
          </dd>
        </div>
      ))}
    </dl>
  </section>
</BaseLayout>
