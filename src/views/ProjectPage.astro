---
/*
 * One page per project. For a project file, the front matter gives the
 * header, the cover and the facts on the side, and the body is the text. For
 * a repository made into a project from GitHub alone, the text is its
 * description and a link to its README.
 *
 * The pages in src/pages/projects/[id].astro and src/pages/es/proyectos/[id].astro
 * choose the language and list the projects (getStaticPaths): one page per
 * project and language, so a new project file or a new repository adds its
 * page in both. There is no server deciding this later.
 */
import { render } from "astro:content";
import GitHubFacts from "../components/GitHubFacts.astro";
import ProjectVisual from "../components/ProjectVisual.astro";
import StatusTag from "../components/StatusTag.astro";
import TechPill from "../components/TechPill.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Locale } from "../i18n/locales";
import { pagePaths } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { formatDate, isoDate } from "../lib/format";
import { getGitHubData } from "../lib/github-data";
import { statsKey } from "../lib/github";
import type { SiteProject } from "../lib/site-projects";

interface Props {
  project: SiteProject;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { id, data } = project;
const t = ui[locale].project;
const Content = project.entry ? (await render(project.entry)).Content : undefined;
const repositoryUrl = `https://github.com/${data.repo}`;
const github = await getGitHubData();
const stats = github.stats[statsKey(data.repo)];
// A project from GitHub shows its whole description here; the card has the short one.
const lead = project.description || data.summary;
// A GitHub description is in English on every page: say so, for screen readers.
const textLang = project.lang === locale ? undefined : project.lang;
---

<BaseLayout
  title={`${data.title} · ${t.titleSuffix}`}
  description={data.summary}
  {locale}
  route={{ page: "project", id }}
>
  <article data-tone={data.tone} class="pt-8 sm:pt-12">
    <a
      href={pagePaths[locale].projects}
      class="inline-flex h-8 items-center gap-1 text-sm text-muted no-underline visited:text-muted hover:text-text"
    >
      <span aria-hidden="true">←</span> {t.allProjects}
    </a>

    <div class="mt-6 grid gap-8 md:grid-cols-2 md:items-center md:gap-10">
      <header>
        <StatusTag status={data.status} {locale} />
        <h1 class="mt-4 text-h2 font-medium tracking-[-0.02em]">{data.title}</h1>
        <p class="mt-1 font-mono text-sm text-muted">{data.repo}</p>
        <p lang={textLang} class="mt-4 text-lead">
          {lead}
        </p>
        {textLang && <p class="mt-2 text-sm text-muted">{t.descriptionFromGitHub}</p>}
        <div class="mt-6 flex flex-wrap gap-2.5">
          <a
            href={repositoryUrl}
            class="inline-flex h-10 items-center rounded-full bg-brand px-4.5 text-sm font-medium text-on-brand no-underline transition-colors visited:text-on-brand hover:bg-brand-hover"
          >
            {t.viewOnGitHub}
          </a>
          {data.demo && (
            <a
              href={data.demo}
              class="inline-flex h-10 items-center rounded-full border border-border bg-surface-2 px-4.5 text-sm font-medium text-text no-underline transition-colors visited:text-text hover:border-border-strong"
            >
              {t.liveDemo}
            </a>
          )}
          {!Content && (
            <a
              href={`${repositoryUrl}#readme`}
              class="inline-flex h-10 items-center rounded-full border border-border bg-surface-2 px-4.5 text-sm font-medium text-text no-underline transition-colors visited:text-text hover:border-border-strong"
            >
              {t.readReadme}
            </a>
          )}
        </div>
      </header>

      <div class="relative aspect-[16/10] overflow-hidden rounded-xl border border-border bg-tone-bg">
        <ProjectVisual
          {id}
          project={data}
          sizes="(min-width: 1024px) 476px, (min-width: 768px) 46vw, 95vw"
          loading="eager"
          tagSpace={false}
        />
      </div>
    </div>

    <div class="mt-12 grid gap-10 border-t border-border pt-10 sm:mt-16 lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-16">
      <!-- 36rem keeps lines under about 78 characters. -->
      <div class="project-text max-w-[36rem]">
        {Content ? (
          <Content />
        ) : (
          <>
            <h2>{t.documentation}</h2>
            <p>
              {t.documentationBefore}
              <a href={`${repositoryUrl}#readme`}>README</a>
              {t.documentationAfter}
            </p>
          </>
        )}
      </div>

      <!--
        On wide screens the facts stay in view while the text scrolls (header
        60 px + 36 px), but only when the window is at least 800 px tall: the
        column is about 600 px, and on a shorter laptop its end would be cut.
      -->
      <aside
        aria-label={t.facts}
        class="lg:top-24 lg:self-start lg:[@media(min-height:50rem)]:sticky"
      >
        <dl class="grid gap-6">
          {data.stack.length > 0 && (
            <div>
              <dt class="text-sm font-medium">{t.stack}</dt>
              <dd class="mt-2.5">
                <ul class="flex flex-wrap gap-1.5">
                  {data.stack.map((item) => (
                    <li>
                      <TechPill name={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          {data.tooling.length > 0 && (
            <div>
              <dt class="text-sm font-medium">{t.tooling}</dt>
              <dd class="mt-2.5">
                <ul class="flex flex-wrap gap-1.5">
                  {data.tooling.map((item) => (
                    <li>
                      <TechPill name={item} />
                    </li>
                  ))}
                </ul>
              </dd>
            </div>
          )}
          <div>
            <dt class="text-sm font-medium">{t.source}</dt>
            <dd class="mt-1.5 font-mono text-sm">
              <a href={repositoryUrl}>{data.repo}</a>
            </dd>
          </div>
        </dl>
        <!--
          What comes from GitHub, apart from what the project file says, so the
          note at the end clearly speaks about this block only.
        -->
        {stats && (
          <section aria-labelledby="on-github" class="mt-6 border-t border-border pt-6">
            <h2 id="on-github" class="mb-4 font-mono text-xs text-muted">
              {t.onGitHub}
            </h2>
            <GitHubFacts {stats} {locale} />
            <p class="mt-4 text-xs leading-relaxed text-muted">
              {github.source === "live" ? (
                <>
                  {t.fromApiBefore}
                  <time datetime={isoDate(github.fetchedAt)}>
                    {formatDate(github.fetchedAt, locale)}
                  </time>
                  {t.fromApiAfter}
                </>
              ) : (
                <>
                  {t.savedCopyBefore}
                  <time datetime={isoDate(github.fetchedAt)}>
                    {formatDate(github.fetchedAt, locale)}
                  </time>
                  {t.savedCopyAfter}
                </>
              )}
            </p>
          </section>
        )}
      </aside>
    </div>
  </article>
</BaseLayout>
