---
/*
 * A technology name in a small neutral pill. Not a link: it only names things.
 * Neutral on purpose: with many cards, coloured pills would compete with the
 * project tones and with violet, which is kept for the identity.
 */
interface Props {
  name: string;
}

const { name } = Astro.props;
---

<span
  class="inline-flex h-6.5 items-center rounded-full bg-surface-2 px-2.5 font-mono text-xs text-muted"
>
  {name}
</span>
