---
import { isCurrent, navigation } from "../data/navigation";
import ThemeToggle from "./ThemeToggle.astro";

const currentPath = Astro.url.pathname;
---

<header class="border-b border-border bg-bg">
  <div class="mx-auto flex max-w-5xl items-center gap-3 px-4 py-3 sm:gap-6 sm:px-6">
    <a
      href="/"
      class="font-mono text-base font-medium text-violet no-underline visited:text-violet hover:underline"
    >
      zxxdev
    </a>

    <nav aria-label="Main" class="ml-auto" data-site-nav>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-nav-list"
        hidden
        class="inline-flex h-10 items-center gap-2 rounded-md border border-border bg-surface px-3 text-sm text-text sm:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <!-- Fixed label: whether it is open is told by aria-expanded, not by the text. -->
        <span>Menu</span>
      </button>

      <ul
        id="site-nav-list"
        class="nav-list flex items-center gap-1 text-[0.9375rem] sm:gap-2"
        data-menu-list
      >
        {navigation.map((item) => {
          const current = isCurrent(item.href, currentPath);
          return (
            <li>
              <a
                href={item.href}
                aria-current={current ? "page" : undefined}
                class:list={[
                  "block rounded-md px-2 py-2 transition-colors sm:px-3",
                  current
                    ? "font-medium text-text decoration-violet decoration-2 underline-offset-8 visited:text-text"
                    : "text-muted no-underline visited:text-muted hover:text-text",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <ThemeToggle />
  </div>
</header>

<style>
  /*
   * Small screens: once the script runs, the list collapses behind the menu
   * button and opens as a panel below the header. Without JavaScript the links
   * stay visible in a row, which still fits at 360 px.
   */
  @media (width < 40rem) {
    [data-site-nav] {
      position: relative;
    }

    [data-site-nav].has-menu .nav-list {
      display: none;
    }

    [data-site-nav].has-menu.is-open .nav-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      right: 0;
      top: calc(100% + 0.5rem);
      z-index: 20;
      min-width: 12rem;
      padding: 0.5rem;
      gap: 0.25rem;
      background-color: var(--c-surface);
      border: 1px solid var(--c-border);
      border-radius: var(--radius-md);
      box-shadow: 0 8px 24px rgb(0 0 0 / 0.12);
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  const button = nav?.querySelector<HTMLButtonElement>("[data-menu-button]");
  if (nav && button) {
    const setOpen = (open: boolean): void => {
      nav.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
    };

    nav.classList.add("has-menu");
    button.hidden = false;

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    // Escape closes the menu and gives focus back to its button.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        button.focus();
      }
    });

    // A click outside the menu closes it.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });

    // Leaving the menu with Tab closes it, so it never stays open over the page.
    nav.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !nav.contains(event.relatedTarget)) {
        setOpen(false);
      }
    });
  }
</script>
