---
import { navigation } from "../data/navigation";
import { otherLocale, type Locale } from "../i18n/locales";
import { isCurrent, isInSection, pagePaths } from "../i18n/routes";
import { ui } from "../i18n/ui";
import Avatar from "./Avatar.astro";
import LanguageSwitch from "./LanguageSwitch.astro";
import ThemeToggle from "./ThemeToggle.astro";

interface Props {
  locale: Locale;
  /** This page in the other language. */
  otherPath: string;
}

const { locale, otherPath } = Astro.props;
const t = ui[locale];
const currentPath = Astro.url.pathname;
---

<!-- Sticky with a solid background: a translucent, blurred header looks soft. -->
<header class="sticky top-0 z-20 border-b border-border bg-bg">
  <div class="mx-auto flex h-14 max-w-5xl items-center gap-2 px-4 sm:h-15 sm:gap-6 sm:px-6">
    <a
      href={pagePaths[locale].home}
      class="flex items-center gap-2.5 font-mono text-[0.9375rem] font-medium text-text no-underline visited:text-text"
    >
      <Avatar size={28} />
      zxxdev
    </a>

    <nav aria-label={t.mainNavigation} class="ml-auto" data-site-nav>
      <button
        type="button"
        data-menu-button
        aria-expanded="false"
        aria-controls="site-nav-list"
        hidden
        class="inline-flex h-10 items-center gap-2 rounded-md border border-border bg-bg px-3 text-sm font-medium text-text sm:hidden"
      >
        <svg
          xmlns="http://www.w3.org/2000/svg"
          viewBox="0 0 24 24"
          width="18"
          height="18"
          fill="none"
          stroke="currentColor"
          stroke-width="1.75"
          stroke-linecap="round"
          aria-hidden="true"
        >
          <path d="M4 7h16M4 12h16M4 17h16"></path>
        </svg>
        <!-- Fixed label: whether it is open is told by aria-expanded, not by the text. -->
        <span>{t.menu}</span>
      </button>

      <ul
        id="site-nav-list"
        class="nav-list flex items-center gap-1 text-sm font-medium"
        data-menu-list
      >
        {navigation(locale).map((item) => {
          // "page" on the page itself; "true" inside its section (a project's
          // page is inside Projects). Both look the same.
          const current = isCurrent(item.href, currentPath)
            ? "page"
            : isInSection(item.href, currentPath)
              ? "true"
              : undefined;
          return (
            <li>
              <a
                href={item.href}
                aria-current={current}
                class:list={[
                  "block rounded-md px-3 py-1.5 no-underline transition-colors",
                  current
                    ? "bg-surface-2 text-text visited:text-text"
                    : "text-muted visited:text-muted hover:text-text",
                ]}
              >
                {item.label}
              </a>
            </li>
          );
        })}
      </ul>
    </nav>

    <LanguageSwitch locale={otherLocale(locale)} href={otherPath} />
    <ThemeToggle {locale} />
  </div>
</header>

<style>
  /*
   * Small screens: once the script runs, the list collapses behind the menu
   * button and opens as a panel below the header. Without JavaScript the links
   * stay visible in a row, which still fits at 360 px.
   */
  @media (width < 40rem) {
    [data-site-nav] {
      position: relative;
    }

    [data-site-nav].has-menu .nav-list {
      display: none;
    }

    [data-site-nav].has-menu.is-open .nav-list {
      display: flex;
      flex-direction: column;
      align-items: stretch;
      position: absolute;
      right: 0;
      top: calc(100% + 0.5rem);
      z-index: 20;
      min-width: 12rem;
      padding: 0.5rem;
      gap: 0.25rem;
      background-color: var(--c-surface);
      border: 1px solid var(--c-border-strong);
      border-radius: 12px;
    }

    /* Touch targets of 44 px in the open panel. */
    [data-site-nav].has-menu.is-open .nav-list a {
      padding-block: 0.625rem;
      font-size: 1rem;
    }
  }
</style>

<script>
  const nav = document.querySelector<HTMLElement>("[data-site-nav]");
  const button = nav?.querySelector<HTMLButtonElement>("[data-menu-button]");
  if (nav && button) {
    const setOpen = (open: boolean): void => {
      nav.classList.toggle("is-open", open);
      button.setAttribute("aria-expanded", String(open));
    };

    nav.classList.add("has-menu");
    button.hidden = false;

    button.addEventListener("click", () => {
      setOpen(button.getAttribute("aria-expanded") !== "true");
    });

    // Escape closes the menu and gives focus back to its button.
    document.addEventListener("keydown", (event) => {
      if (event.key === "Escape" && nav.classList.contains("is-open")) {
        setOpen(false);
        button.focus();
      }
    });

    // A click outside the menu closes it.
    document.addEventListener("click", (event) => {
      if (event.target instanceof Node && !nav.contains(event.target)) setOpen(false);
    });

    // Leaving the menu with Tab closes it, so it never stays open over the page.
    nav.addEventListener("focusout", (event) => {
      if (!(event.relatedTarget instanceof Node) || !nav.contains(event.relatedTarget)) {
        setOpen(false);
      }
    });
  }
</script>
