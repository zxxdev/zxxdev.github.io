---
/*
 * A project card: cover, status tag, title, repository and stack. It opens the
 * project's page on this site.
 *
 * - The whole card can be clicked: the title link is stretched over it with
 *   ::after, and the focus ring is drawn on the card when the link has
 *   keyboard focus (:has(:focus-visible)), not after a mouse click.
 * - The status tag, the cover's name and the title all start 20 px from the
 *   edge.
 * - On hover only the border changes, to the project's tone. No movement and
 *   no zoom: they make the page look soft.
 * - data-technologies lists the stack as slugs, for the filter on the Projects
 *   page.
 */
import { technologySlug } from "../data/technologies";
import type { Locale } from "../i18n/locales";
import { projectPath } from "../i18n/routes";
import { ui } from "../i18n/ui";
import { formatDate, isoDate } from "../lib/format";
import { repositoryStats } from "../lib/github-data";
import type { SiteProject } from "../lib/site-projects";
import ProjectVisual from "./ProjectVisual.astro";
import StatusTag from "./StatusTag.astro";
import TechPill from "./TechPill.astro";

interface Props {
  project: SiteProject;
  locale: Locale;
}

const { project, locale } = Astro.props;
const { id, data } = project;
const t = ui[locale].card;
// A GitHub description is in English on every page: say so, for screen readers.
const textLang = project.lang === locale ? undefined : project.lang;
// From GitHub when the site was built (or the saved copy): never typed by hand.
const stats = await repositoryStats(data.repo);
---

<li
  data-tone={data.tone}
  data-technologies={data.stack.map(technologySlug).join(" ")}
  class="relative overflow-hidden rounded-xl border border-border transition-colors hover:border-tone-line has-focus-visible:outline-2 has-focus-visible:outline-offset-3 has-focus-visible:outline-violet"
>
  <div class="relative aspect-[16/10] border-b border-border bg-tone-bg">
    <ProjectVisual
      {id}
      project={data}
      sizes="(min-width: 1024px) 476px, (min-width: 640px) 48vw, 95vw"
    />
    <StatusTag status={data.status} {locale} class="absolute top-5 left-5" />
  </div>
  <div class="px-5 pt-4.5 pb-5">
    <h3 class="text-h4 font-semibold tracking-tight">
      <a
        href={projectPath(locale, id)}
        class="text-text no-underline visited:text-text after:absolute after:inset-0 focus-visible:outline-none"
      >
        {data.title}
      </a>
    </h3>
    <p class="mt-0.5 font-mono text-xs text-muted">
      {data.repo}
      {/* The date part never splits: if it does not fit, it moves down whole, dot included. */}
      {stats && (
        <>
          {" "}
          <span class="whitespace-nowrap">
            <span aria-hidden="true">· </span>
            <span class="sr-only">, </span>
            {t.updated}{" "}
            <time datetime={isoDate(stats.pushedAt)}>{formatDate(stats.pushedAt, locale)}</time>
          </span>
        </>
      )}
    </p>
    <p lang={textLang} class="mt-2.5 text-sm leading-relaxed text-muted">
      {data.summary}
    </p>
    {data.stack.length > 0 && (
      <ul aria-label={t.stack} class="mt-4 flex flex-wrap gap-1.5">
        {data.stack.map((item) => (
          <li>
            <TechPill name={item} />
          </li>
        ))}
      </ul>
    )}
  </div>
</li>
