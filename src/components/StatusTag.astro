---
/*
 * A project's status in a small pill: "Live" with a filled teal dot, or the
 * version of an early project ("Alpha · 0.1.0") with an empty ring, so the
 * shape tells them apart too, not only the colour. The text is built from the
 * project's data by statusLabel(), never typed by hand.
 *
 * It sits on a solid background, so its contrast does not depend on what is
 * behind it (a cover or the page).
 */
import type { Locale } from "../i18n/locales";
import type { ProjectStatus } from "../lib/project-schema";
import { statusLabel } from "../lib/projects";

interface Props {
  status: ProjectStatus;
  locale: Locale;
  class?: string;
}

const { status, locale, class: className } = Astro.props;
---

<span
  class:list={[
    "inline-flex h-6 items-center gap-1.5 rounded-full border border-border bg-surface px-2.5 font-mono text-xs text-text",
    className,
  ]}
>
  <span
    aria-hidden="true"
    class:list={[
      "size-1.5 rounded-full",
      status.kind === "live" ? "bg-status" : "border border-muted",
    ]}
  ></span>
  {statusLabel(status, locale)}
</span>
