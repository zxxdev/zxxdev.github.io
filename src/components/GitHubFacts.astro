---
/*
 * What GitHub says about a project's repository, for the side column of its
 * page: last change, latest release, stars and languages. Every number comes
 * from the GitHub API when the site was built, or from the saved copy if
 * GitHub did not answer; the page says which, and from when, under the list.
 *
 * Renders <dt>/<dd> pairs, so it goes inside the page's <dl>.
 *
 * The language bar is decorative (aria-hidden): the list under it says the
 * same in words. Its segments use the project's tone, strongest for the main
 * language, so it never adds colours from outside the closed list.
 */
import { formatDate, formatShare, isoDate } from "../lib/format";
import type { RepositoryStats } from "../lib/github";

interface Props {
  stats: RepositoryStats;
}

const { stats } = Astro.props;
const repositoryUrl = `https://github.com/${stats.fullName}`;
// Opacity per position in the bar: the main language solid, then lighter.
const segmentOpacity = ["opacity-100", "opacity-60", "opacity-35", "opacity-20"];
---

<div>
  <dt class="text-sm font-medium">Last change</dt>
  <dd class="mt-1.5 text-sm">
    <time datetime={isoDate(stats.pushedAt)}>{formatDate(stats.pushedAt)}</time>
  </dd>
</div>
<div>
  <dt class="text-sm font-medium">Latest release</dt>
  <dd class="mt-1.5 font-mono text-sm">
    {stats.latestRelease ? (
      <a href={stats.latestRelease.url}>{stats.latestRelease.tag}</a>
    ) : (
      <span class="font-sans text-muted">None yet</span>
    )}
  </dd>
</div>
<div>
  <dt class="text-sm font-medium">Stars</dt>
  <dd class="mt-1.5 text-sm">
    <a href={`${repositoryUrl}/stargazers`}>{stats.stars}</a>
  </dd>
</div>
{stats.languages.length > 0 && (
  <div>
    <dt class="text-sm font-medium">Languages</dt>
    <dd class="mt-2.5">
      <div aria-hidden="true" class="flex h-2 gap-0.5 overflow-hidden rounded-full">
        {stats.languages.map((language, index) => (
          <span
            class:list={["h-full bg-tone-line", segmentOpacity[index] ?? "opacity-20"]}
            style={`width: ${String(language.share * 100)}%`}
          />
        ))}
      </div>
      <ul class="mt-2.5 grid gap-1 text-sm">
        {stats.languages.map((language) => (
          <li class="flex justify-between gap-4">
            <span>{language.name}</span>
            <span class="font-mono text-xs leading-5 text-muted">
              {formatShare(language.share)}
            </span>
          </li>
        ))}
      </ul>
    </dd>
  </div>
)}
