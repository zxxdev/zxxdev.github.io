---
import plexSansLatin from "@fontsource-variable/ibm-plex-sans/files/ibm-plex-sans-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#f7f8fa" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e131b" media="(prefers-color-scheme: dark)" />
    <!-- Only the main font is preloaded; the rest load when a page needs them. -->
    <link rel="preload" href={plexSansLatin} as="font" type="font/woff2" crossorigin />
    <!--
      Runs before the page is painted, so a saved theme is applied without a flash
      of the other one. With no saved choice it does nothing and CSS follows the
      system setting.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        /* Storage blocked: follow the system setting. */
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <div
      aria-hidden="true"
      class="h-[3px] w-full bg-linear-to-r from-accent to-violet"
      data-top-line
    ></div>
    <a
      href="#content"
      class="sr-only rounded-md bg-accent px-4 py-2 font-medium text-on-accent no-underline focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-30 visited:text-on-accent"
    >
      Skip to content
    </a>
    <Header />
    <main
      id="content"
      tabindex="-1"
      class="mx-auto w-full max-w-5xl flex-1 px-4 focus:outline-none sm:px-6"
    >
      <slot />
    </main>
    <Footer />
  </body>
</html>
