---
import geistLatin from "@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url";
import Footer from "../components/Footer.astro";
import Header from "../components/Header.astro";
import { defaultLocale, languageStorageKey, otherLocale, type Locale } from "../i18n/locales";
import { alternates, pagePaths, routePath, type Route } from "../i18n/routes";
import { ui } from "../i18n/ui";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
  locale: Locale;
  /**
   * The page, so the head can list its version in every language and the
   * header can link the other one. Left out on the "page not found" page,
   * which has no address of its own.
   */
  route?: Route;
}

const { title, description, locale, route } = Astro.props;
const t = ui[locale];
const canonical = new URL(Astro.url.pathname, Astro.site);
const versions = route ? alternates(route) : [];
// The language switch opens this page in the other language, or that language's home.
const other = otherLocale(locale);
const otherPath = route ? routePath(other, route) : pagePaths[other].home;
// Only the English home page sends a Spanish browser to the Spanish one (ADR 0007).
const isEnglishHome = locale === defaultLocale && route?.page === "home";
---

<!doctype html>
<html lang={locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <!--
      The same page in each language, so search engines show the right one and
      do not treat them as duplicates. x-default is the version for a language
      the site does not have: English.
    -->
    {
      versions.map((version) => (
        <link rel="alternate" hreflang={version.locale} href={new URL(version.path, Astro.site)} />
      ))
    }
    {
      route && (
        <link
          rel="alternate"
          hreflang="x-default"
          href={new URL(routePath(defaultLocale, route), Astro.site)}
        />
      )
    }
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="theme-color" content="#ffffff" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#080808" media="(prefers-color-scheme: dark)" />
    <!-- Only the main font is preloaded; the rest load when a page needs them. -->
    <link rel="preload" href={geistLatin} as="font" type="font/woff2" crossorigin />
    {
      isEnglishHome && (
        <script
          is:inline
          define:vars={{ storageKey: languageStorageKey, spanishHome: pagePaths.es.home }}
        >
          // Runs before the page is drawn. A visitor arriving from outside the
          // site, who has never used the language switch, and whose browser
          // prefers Spanish over English, goes to the Spanish home page. Only
          // here: a link to any other page opens what was linked, and moving
          // around the site never changes the language by itself.
          // The language choice repeats preferredLocale() in src/i18n/locales.ts.
          try {
            const fromThisSite =
              document.referrer !== "" &&
              new URL(document.referrer).origin === window.location.origin;
            let wanted = localStorage.getItem(storageKey);
            if (wanted !== "en" && wanted !== "es") {
              wanted = "en";
              for (const language of navigator.languages) {
                const main = language.toLowerCase().split("-")[0];
                if (main === "en" || main === "es") {
                  wanted = main;
                  break;
                }
              }
            }
            if (wanted === "es" && !fromThisSite) window.location.replace(spanishHome);
          } catch {
            /* Storage or the referrer cannot be read: stay on this page. */
          }
        </script>
      )
    }
    <!--
      Runs before the page is painted, so a saved theme is applied without a flash
      of the other one. With no saved choice it does nothing and CSS follows the
      system setting.
    -->
    <script is:inline>
      try {
        const saved = localStorage.getItem("theme");
        if (saved === "light" || saved === "dark") document.documentElement.dataset.theme = saved;
      } catch {
        /* Storage blocked: follow the system setting. */
      }
    </script>
  </head>
  <body class="flex min-h-dvh flex-col bg-bg text-text antialiased">
    <div aria-hidden="true" class="h-[3px] w-full bg-brand" data-top-line></div>
    <a
      href="#content"
      class="sr-only rounded-md bg-accent px-4 py-2 font-medium text-on-accent no-underline focus:not-sr-only focus:absolute focus:top-3 focus:left-3 focus:z-30 visited:text-on-accent"
    >
      {t.skipToContent}
    </a>
    <Header {locale} {otherPath} />
    <main
      id="content"
      tabindex="-1"
      class="mx-auto w-full max-w-5xl flex-1 px-4 focus:outline-none sm:px-6"
    >
      <slot />
    </main>
    <Footer {locale} />
  </body>
</html>
